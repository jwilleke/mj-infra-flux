# Copy to /etc/gatus/gatus.env on jims-test-instance (mode 600, root:root).
# systemd reads this file as root before dropping to the gatus user.
#
# Put the Resend API key here. Do not commit the live file.
# OpenBao: kv/hosts/gcp-watcher/gatus  key smtp-password
#
# After setting the key:
#   sudo systemctl restart gatus
GATUS_SMTP_PASSWORD=replace-me
